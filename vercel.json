{
  "crons": [
    {
      "path": "/api/admin/refresh-projections",
      "schedule": "30 12 * * *"
    },
    {
      "path": "/api/betting/refresh-odds",
      "schedule": "0 15 * * 0,1,4"
    }
  ],
  "rewrites": [
    {
      "source": "/api/supabase/(.*)",
      "destination": "/api/supabase/[...path]"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
